{
  "listen": ":7863",
  "api_key": "test_key",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "server": {
    "max_body_mb": 8,
    "max_rotate": 3,
    "read_timeout_seconds": 300
  },
  "cooldown": {
    "soft_rate": "600s",
    "soft_rate_max": "2h"
  },
  "schedule": {
    "checkin_hours": [
      9,
      21
    ],
    "travel_hours": [
      9,
      21
    ],
    "activity_hours": [
      10
    ],
    "keepalive_hours": [
      22
    ],
    "blackcat_hours": [
      23
    ],
    "checkin_enabled": true,
    "travel_enabled": true,
    "activity_enabled": true,
    "keepalive_enabled": true,
    "blackcat_enabled": true,
    "balance_refresh_enabled": true,
    "balance_refresh_minutes": 5,
    "auth_watch_enabled": true,
    "auth_watch_seconds": 30
  },
  "global": {
    "enabled": true,
    "chat_base": "",
    "billing_base": ""
  },
  "upstream": {
    "timeout_seconds": 120,
    "header_timeout_seconds": 120,
    "idle_timeout_seconds": 300,
    "user_agent": "",
    "client_version": "",
    "cli_version": "",
    "client_name": "",
    "device_token": "",
    "device_token_file": "",
    "passthrough_ip": false,
    "machine_id_headers": true,
    "disable_http2": false,
    "tls_handshake_timeout_seconds": 30,
    "dial_timeout_seconds": 30,
    "idle_conn_timeout_seconds": 90
  },
  "features": {
    "sanitize_blacklist_fingerprints": true,
    "zerowidth_sanitize": false
  },
  "prompt": {
    "mode": "passthrough",
    "file": ""
  },
  "upstash": {
    "url": "",
    "token": ""
  },
  "pool": {
    "max_in_flight": 3,
    "max_in_flight_global": 2,
    "breaker_threshold": 3,
    "breaker_cooldown": "30m",
    "breaker_cooldown_max": "6h",
    "idle_weight_per_hour": 0.5,
    "idle_weight_max": 5.0,
    "expiring_soon": "168h"
  },
  "session_sticky": {
    "enabled": true,
    "ttl": "30m",
    "gc_interval": "5m"
  },
  "models": {
    "strip_realm_prefix": true,
    "realm_precedence": "global",
    "hidden_models": [
      "default-model",
      "fast-model",
      "balanced-model",
      "primary-model",
      "deep-model"
    ],
    "pinned_models": [
      {
        "id": "deepseek-v4.1-flash",
        "name": "Deepseek-V4.1-Flash",
        "credits": "x0.03",
        "context_length": 1000000,
        "max_output_tokens": 128000,
        "default_effort": "high",
        "supports_reasoning": true,
        "supported_efforts": []
      }
    ]
  }
}
